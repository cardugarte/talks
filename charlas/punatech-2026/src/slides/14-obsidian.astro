---
import SlideShell from '@talks/shared/components/SlideShell.astro';
const base = import.meta.env.BASE_URL;
---
<div class="slide">
  <SlideShell number="14" total="19" label="Capa 6" />
  <h2 class="title"><em>Obsidian</em></h2>

  <p class="body" style="text-align:center;margin-bottom:12px;">
    La biblioteca del agente. Un vault de Obsidian como <strong>segunda mente conectada</strong>.
  </p>

  <div class="obs-layout">
    <img
      class="obs-brain"
      src={`${base}/obsidian.jpg`.replace(/\/+/g, '/')}
      alt="Grafo de conocimiento conectado a un cerebro"
      loading="lazy"
      decoding="async"
    />

    <ul class="ilist obs-ilist">
      <li><span class="ic">📄</span><span><strong>Documentación</strong> — specs, ADRs, runbooks del proyecto</span></li>
      <li><span class="ic">🔗</span><span><strong>Links entre conceptos</strong> — el agente navega el grafo para entender contexto</span></li>
      <li><span class="ic">📓</span><span><strong>Notas de reuniones</strong> — decisiones y razonamientos</span></li>
      <li><span class="ic">🧩</span><span><strong>Patrones</strong> — cómo se resuelven problemas en este equipo</span></li>
    </ul>
  </div>

  <p class="body" style="text-align:center;margin-top:8px;">
    Lo que Engram guarda en <em>sesión</em>, Obsidian lo guarda en <em>conocimiento permanente</em>.
  </p>
</div>

<style>
/* ══ SLIDE 14 — OBSIDIAN ══ */
.obs-layout {
  display: flex;
  align-items: center;
  gap: 44px;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}
.obs-brain {
  width: 320px;
  height: auto;
  max-height: 54vh;
  object-fit: contain;
  flex-shrink: 0;
  border-radius: 10px;
  border: 1px solid rgba(0,232,122,0.15);
  box-shadow: 0 0 40px rgba(0,232,122,0.08), 0 0 60px rgba(138,43,226,0.06);
}
.obs-ilist {
  margin-top: 0;
  flex: 1;
  max-width: 560px;
}

@media (max-width: 768px) {
  .obs-layout { flex-direction: column; gap: 16px; }
  .obs-brain { width: 70%; max-width: 220px; max-height: 30vh; }
  .obs-ilist { max-width: 100%; width: 100%; text-align: left; }
}
</style>
