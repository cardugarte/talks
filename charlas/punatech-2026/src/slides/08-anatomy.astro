---
import SlideShell from '@talks/shared/components/SlideShell.astro';
---
<div class="slide">
  <SlideShell number="08" total="19" label="Disección" />
  <h2 class="title">Anatomía de un <em>agente</em></h2>
  <p class="body" style="text-align:center;margin-bottom:16px;">
    Vamos a abrir uno y ver qué tiene adentro.
  </p>

  <div class="anat-jspwrap" id="anat-container">
    <div class="anat-jsc-core" id="anat-llm">
      <div class="anat-core-icon">🧠</div>
      <div class="anat-core-name">LLM</div>
      <div class="anat-core-desc">El cerebro</div>
    </div>

    <div class="anat-jsc-grid">
      <div class="anat-jsc-item" id="anat-skills">
        <span class="anat-jsc-icon">🛠️</span>
        <span class="anat-jsc-label">Skills</span>
        <span class="anat-jsc-desc">Capacidades específicas</span>
      </div>
      <div class="anat-jsc-item" id="anat-sub">
        <span class="anat-jsc-icon">🤝</span>
        <span class="anat-jsc-label">Sub-agentes</span>
        <span class="anat-jsc-desc">Delegación en paralelo</span>
      </div>
      <div class="anat-jsc-item" id="anat-mcp">
        <span class="anat-jsc-icon">🔌</span>
        <span class="anat-jsc-label">MCP</span>
        <span class="anat-jsc-desc">Conexión con el mundo</span>
      </div>
      <div class="anat-jsc-item" id="anat-acp">
        <span class="anat-jsc-icon">📡</span>
        <span class="anat-jsc-label">ACP</span>
        <span class="anat-jsc-desc">Habla con otros agentes</span>
      </div>
      <div class="anat-jsc-item anat-mem" id="anat-engram">
        <span class="anat-jsc-icon">💾</span>
        <span class="anat-jsc-label">Engram</span>
        <span class="anat-jsc-desc">Memoria persistente</span>
      </div>
      <div class="anat-jsc-item anat-mem" id="anat-obs">
        <span class="anat-jsc-icon">🗂️</span>
        <span class="anat-jsc-label">Obsidian</span>
        <span class="anat-jsc-desc">Base de conocimiento</span>
      </div>
    </div>
  </div>

  <p class="body" style="font-size:1.18rem;margin-top:12px;text-align:center;">
    Vamos parte por parte. <em>Cada pieza tiene un rol específico.</em>
  </p>
</div>

<style>
/* ══ SLIDE 08 — ANATOMY JSPLUMB ══ */
.anat-jspwrap {
  position: relative;
  display: flex;
  align-items: center;
  gap: 80px;
  max-width: 1040px;
  width: 100%;
  margin: 0 auto;
}

.anat-jsc-core {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: rgba(0,232,122,0.07);
  border: 2px solid rgba(0,232,122,0.5);
  box-shadow: 0 0 36px rgba(0,232,122,0.15);
  flex-shrink: 0;
  gap: 4px;
  z-index: 2;
  position: relative;
}
.anat-core-icon { font-size: 1.8rem; line-height: 1; }
.anat-core-name { font-family: var(--font-m); font-size: 0.8rem; color: var(--green); letter-spacing: 0.12em; text-transform: uppercase; }
.anat-core-desc { font-family: var(--font-m); font-size: 0.68rem; color: var(--muted); }

.anat-jsc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  flex: 1;
  position: relative;
  z-index: 2;
}

.anat-jsc-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  background: rgba(15,35,24,0.75);
  border: 1px solid rgba(0,232,122,0.15);
  border-radius: 8px;
  padding: 16px 18px;
  position: relative;
}
.anat-mem {
  border-color: rgba(200,85,245,0.2);
  background: rgba(200,85,245,0.04);
}
.anat-jsc-icon { font-size: 1.1rem; line-height: 1; margin-bottom: 2px; }
.anat-jsc-label {
  font-family: var(--font-m);
  font-size: 0.8rem;
  color: var(--green);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.anat-mem .anat-jsc-label { color: #c855f5; }
.anat-jsc-desc {
  font-family: var(--font-b);
  font-size: 0.86rem;
  color: var(--muted);
  line-height: 1.3;
}

/* jsPlumb SVG overlay sits at z-index 1 between core and grid */
.anat-jspwrap .jtk-connector { z-index: 1; }

@media (max-width: 768px) {
  /* Apilar core + grilla. Los conectores jsPlumb (anclas Right/Left)
     no tienen sentido apilados → se ocultan. */
  .anat-jspwrap { flex-direction: column; gap: 18px; }
  .anat-jspwrap .jtk-connector,
  .anat-jspwrap .jtk-endpoint { display: none !important; }
  .anat-jsc-grid { width: 100%; }
}
</style>

<script>
  import { newInstance, AnchorLocations, ArrowOverlay, LabelOverlay } from '@jsplumb/browser-ui';

  const slide = document.querySelector('.slide:has(#anat-container)');

  function initJsPlumb() {
    const container = document.getElementById('anat-container');
    if (!container || (container as any)._jspInitialized) return;
    (container as any)._jspInitialized = true;

    const jsp = newInstance({
      container,
      paintStyle: { stroke: 'rgba(0,232,122,0.35)', strokeWidth: 1.2 },
      connector: { type: 'Bezier', options: { curviness: 50 } },
      anchors: ['Right', 'Left'],
      endpoints: [
        { type: 'Dot', options: { radius: 2.5, fill: '#00e87a' } },
        { type: 'Dot', options: { radius: 2.5, fill: '#00e87a' } },
      ],
    });

    const targets = ['anat-skills', 'anat-sub', 'anat-mcp', 'anat-acp'];
    const memTargets = ['anat-engram', 'anat-obs'];

    targets.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        jsp.connect({
          source: document.getElementById('anat-llm')!,
          target: el,
          paintStyle: { stroke: 'rgba(0,232,122,0.35)', strokeWidth: 1.2 },
        });
      }
    });

    memTargets.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        jsp.connect({
          source: document.getElementById('anat-llm')!,
          target: el,
          paintStyle: { stroke: 'rgba(200,85,245,0.35)', strokeWidth: 1.2 },
        });
      }
    });
  }

  if (slide?.classList.contains('active')) {
    setTimeout(initJsPlumb, 100);
  } else {
    const obs = new MutationObserver(() => {
      if (slide?.classList.contains('active')) { obs.disconnect(); setTimeout(initJsPlumb, 150); }
    });
    if (slide) obs.observe(slide, { attributes: true, attributeFilter: ['class'] });
  }
</script>
