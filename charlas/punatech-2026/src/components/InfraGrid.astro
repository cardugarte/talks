---
interface Props {
  items: { icon: string; title: string; description: string; highlight?: boolean }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<div class:list={["grid grid-cols-2 gap-3.5 mt-7 w-full max-w-[840px] text-left", className]}>
  {items.map((item) => (
    <div class:list={[
      "bg-stone/60 border border-green/10 rounded-lg p-5 flex gap-3.5 items-start",
      item.highlight && "border-green/30 shadow-[0_0_20px_rgba(0,232,122,0.08)]"
    ]}>
      <div class="text-2xl min-w-[34px]">{item.icon}</div>
      <div>
        <h4 class="font-mono text-[0.7rem] text-green tracking-widest uppercase mb-1">{item.title}</h4>
        <p class="text-[0.85rem] text-muted leading-relaxed">{item.description}</p>
      </div>
    </div>
  ))}
</div>
