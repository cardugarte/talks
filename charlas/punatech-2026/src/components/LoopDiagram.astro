---
interface Props {
  steps: { icon: string; label: string }[];
}
const { steps } = Astro.props;
---
<div class="flex items-center gap-0 mt-9" id="loop-diagram">
  {steps.map((step, i) => (
    <Fragment>
      <div class="flex flex-col items-center gap-2 loop-step" style={`--delay: ${i * 300}ms`}>
        <div class="w-[60px] h-[60px] rounded-full bg-stone/80 border-2 border-green/15 flex items-center justify-center text-xl shadow-none transition-all duration-500">
          {step.icon}
        </div>
        <span class="font-mono text-[0.6rem] text-green tracking-widest uppercase">
          {step.label}
        </span>
      </div>
      {i < steps.length - 1 && (
        <div class="w-9 h-0.5 bg-gradient-to-r from-green2 to-green relative mx-1 mb-[22px]">
          <div class="absolute -right-px -top-1 border-l-[8px] border-l-green border-y-[5px] border-y-transparent"></div>
        </div>
      )}
    </Fragment>
  ))}
</div>

<script>
  const diagram = document.getElementById('loop-diagram');
  const slide = diagram?.closest('.slide');
  const loopSteps = diagram?.querySelectorAll('.loop-step');

  function animate() {
    loopSteps?.forEach((step, i) => {
      const circle = step.querySelector('div');
      if (!circle) return;
      setTimeout(() => {
        circle.style.borderColor = 'rgba(0, 232, 122, 0.6)';
        circle.style.boxShadow = '0 0 20px rgba(0, 232, 122, 0.25)';
      }, i * 300);
    });
  }

  if (slide?.classList.contains('active')) {
    animate();
  } else {
    const observer = new MutationObserver(() => {
      if (slide?.classList.contains('active')) {
        animate();
        observer.disconnect();
      }
    });
    if (slide) observer.observe(slide, { attributes: true, attributeFilter: ['class'] });
  }
</script>
