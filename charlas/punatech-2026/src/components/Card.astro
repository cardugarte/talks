---
interface Props {
  title?: string;
  variant?: 'default' | 'purple' | 'muted';
  class?: string;
}
const { title, variant = 'default', class: className = '' } = Astro.props;

const borderColor = {
  default: 'border-green/10',
  purple: 'border-purple/20',
  muted: 'border-muted/20',
}[variant];

const titleColor = {
  default: 'text-green',
  purple: 'text-purple',
  muted: 'text-muted',
}[variant];
---
<div class:list={["bg-stone/70 border rounded-lg p-6 backdrop-blur-sm", borderColor, className]}>
  {title && (
    <h3 class:list={["font-mono text-[0.68rem] tracking-[0.15em] uppercase mb-3", titleColor]}>
      {title}
    </h3>
  )}
  <div class="text-sm leading-relaxed text-muted">
    <slot />
  </div>
</div>
