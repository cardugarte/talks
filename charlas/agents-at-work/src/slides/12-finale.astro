---
import { Globe, Package, MessageSquare, Puzzle, CheckCircle } from 'lucide-astro';
---
<!-- ── SLIDE 16: FINALE + RECURSOS ── -->
<div class="slide s-final" data-index="15">
  <div class="slide-num">16 / 17</div>
  <div class="lbl">Siguiente paso</div>
  <span class="big">Bienvenido al presente</span>
  <div class="wow">El agente<br>trabaja</div>

  <div class="two-col" style="margin-top:28px;max-width:760px;text-align:left;">
    <div class="card">
      <h3>Recursos</h3>
      <p>
        <span class="res-icon"><Globe size={14} /></span> <strong>openclaw.dev</strong> — docs y referencia<br>
        <span class="res-icon"><Package size={14} /></span> <strong>github.com/openclaw</strong> — código fuente<br>
        <span class="res-icon"><MessageSquare size={14} /></span> <strong>Discord oficial</strong> — comunidad<br>
        <span class="res-icon"><Puzzle size={14} /></span> <strong>clawhub.dev</strong> — registry de skills
      </p>
    </div>
    <div class="card" style="border-color:rgba(0,232,122,0.2);">
      <h3>Próximos pasos</h3>
      <p>
        <span class="res-icon res-green"><CheckCircle size={14} /></span> <em>Instalá más skills</em> desde ClawHub<br>
        <span class="res-icon res-green"><CheckCircle size={14} /></span> <em>Conectá otro canal</em> (Discord, CLI)<br>
        <span class="res-icon res-green"><CheckCircle size={14} /></span> <em>Automatizá algo real</em> de tu trabajo<br>
        <span class="res-icon res-green"><CheckCircle size={14} /></span> <em>Contribuí una skill</em> open source
      </p>
    </div>
  </div>
</div>

<style>
.res-icon {
  display: inline-flex;
  vertical-align: middle;
  margin-right: 6px;
  color: var(--muted);
}
.res-icon.res-green { color: var(--green); }
</style>
