---
import { Brain, Wrench, Database, Radio } from 'lucide-astro';
---
<!-- ── SLIDE 4: ANATOMÍA ── -->
<div class="slide" data-index="3">
  <div class="slide-num">04 / 17</div>
  <div class="lbl">Arquitectura</div>
  <div class="title">Anatomía de<br>un <em>agente</em></div>

  <div class="infra" style="margin-top:32px;max-width:860px;">
    <div class="ic-card">
      <div class="ii"><Brain size={32} /></div>
      <div>
        <h4>Cerebro — LLM</h4>
        <p>Razona sobre el contexto. Decide qué acción tomar y con qué herramienta. GPT-4o, Claude, Gemini...</p>
      </div>
    </div>
    <div class="ic-card">
      <div class="ii"><Wrench size={32} /></div>
      <div>
        <h4>Herramientas — Tools</h4>
        <p>Lo que puede hacer: email, terminal, browser, APIs, calendario, base de datos...</p>
      </div>
    </div>
    <div class="ic-card">
      <div class="ii"><Database size={32} /></div>
      <div>
        <h4>Memoria — Context</h4>
        <p>Historial de la conversación + resultados previos. Le permite corregir y aprender en el loop.</p>
      </div>
    </div>
    <div class="ic-card">
      <div class="ii"><Radio size={32} /></div>
      <div>
        <h4>Canal — Interface</h4>
        <p>Dónde recibe objetivos y responde: Telegram, Discord, CLI, API, web...</p>
      </div>
    </div>
  </div>
</div>
