---
interface Props {
  command: string;
  outputs: { text: string; highlight?: boolean }[];
  id?: string;
}
const { command, outputs, id = 'terminal' } = Astro.props;
---
<div class="bg-bg2/90 border border-green/20 rounded-[10px] p-5 backdrop-blur-sm shadow-[0_0_60px_rgba(0,232,122,0.06),inset_0_0_30px_rgba(0,0,0,0.3)] max-w-[520px]">
  <div class="flex gap-1.5 mb-4">
    <div class="w-[11px] h-[11px] rounded-full bg-[#ff5f57]"></div>
    <div class="w-[11px] h-[11px] rounded-full bg-[#ffbd2e]"></div>
    <div class="w-[11px] h-[11px] rounded-full bg-[#28ca41]"></div>
  </div>
  <div class="font-mono text-[0.88rem] leading-loose">
    <span class="text-green">➜ </span>
    <span class="text-cyan" id={`${id}-cmd`}></span>
    <span class="inline-block w-[9px] h-[1em] bg-green align-middle ml-0.5 animate-[blink_1s_step-end_infinite]" id={`${id}-cursor`}></span>
  </div>
  {outputs.map((out, i) => (
    <div
      class:list={["font-mono leading-loose opacity-0 transition-opacity duration-500", out.highlight ? "text-purple text-[0.88rem]" : "text-muted text-[0.78rem]"]}
      id={`${id}-out-${i}`}
    >
      {out.text}
    </div>
  ))}
</div>

<script define:vars={{ command, id, outputCount: outputs.length }}>
  let i = 0;
  const cmdEl = document.getElementById(`${id}-cmd`);
  const cursorEl = document.getElementById(`${id}-cursor`);

  function type() {
    if (i < command.length) {
      cmdEl.textContent += command[i++];
      setTimeout(type, 32 + Math.random() * 28);
    } else {
      cursorEl.style.display = 'none';
      let delay = 400;
      for (let j = 0; j < outputCount; j++) {
        setTimeout(() => {
          const el = document.getElementById(`${id}-out-${j}`);
          if (el) el.style.opacity = '1';
        }, delay);
        delay += 800;
      }
    }
  }

  const slide = cmdEl?.closest('.slide');
  if (slide?.classList.contains('active')) {
    setTimeout(type, 600);
  } else {
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.type === 'attributes' && slide?.classList.contains('active')) {
          setTimeout(type, 600);
          observer.disconnect();
        }
      }
    });
    if (slide) observer.observe(slide, { attributes: true, attributeFilter: ['class'] });
  }
</script>
