---
import '../styles/global.css';

interface Props {
  title?: string;
  total?: number;
}
const { title = 'Agents at Work — De chatbot a colega' } = Astro.props;
---
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=JetBrains+Mono:wght@300;400;700&family=Exo+2:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>

<canvas class="stars" id="stars"></canvas>

<svg class="mountains" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
  <polygon points="0,400 0,280 120,180 240,260 360,120 480,200 600,80 720,160 840,40 960,140 1080,60 1200,150 1320,90 1440,170 1440,400" fill="#00e87a"/>
  <polygon points="0,400 0,320 100,250 200,300 320,200 440,270 560,150 680,230 800,100 920,200 1040,130 1160,220 1280,160 1440,240 1440,400" fill="#007a40"/>
  <polygon points="0,400 0,360 80,320 200,350 340,280 460,330 580,260 700,310 820,240 940,290 1060,250 1180,300 1300,260 1440,310 1440,400" fill="#003d20"/>
</svg>

<div id="progress"></div>
<div id="deck">
  <slot />
</div>

<div id="nav"></div>
<div id="hint">← → para navegar</div>

<script is:inline>
// ── STARS ──
const canvas = document.getElementById('stars');
const ctx = canvas.getContext('2d');
canvas.width = window.innerWidth; canvas.height = window.innerHeight;
const stars = Array.from({length:160},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height*0.7,r:Math.random()*1+0.2,a:Math.random()*0.5+0.1}));
function drawStars(){ctx.clearRect(0,0,canvas.width,canvas.height);stars.forEach(s=>{ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fillStyle=`rgba(224,242,233,${s.a})`;ctx.fill();});}
drawStars();

// ── TYPING ──
const cmd = 'openclaw run --objective "change the world"';
let i=0;
const te = document.getElementById('typed-cmd');
const ce = document.getElementById('cursor-1');
function type(){if(i<cmd.length){te.textContent+=cmd[i++];setTimeout(type,32+Math.random()*28);}else{ce.style.display='none';setTimeout(()=>{let o1=document.getElementById('out-1');o1.style.opacity=1;o1.style.transition='opacity 0.5s';setTimeout(()=>{let o2=document.getElementById('out-2');o2.style.opacity=1;o2.style.transition='opacity 0.5s';},800);},400);}}
setTimeout(type,600);

// ── NAVIGATION ──
const slides=document.querySelectorAll('.slide');
const total=slides.length;
const navEl=document.getElementById('nav');
const prog=document.getElementById('progress');
slides.forEach((_,j)=>{const d=document.createElement('div');d.className='ndot'+(j===0?' active':'');d.addEventListener('click',()=>goTo(j));navEl.appendChild(d);});
function upd(){prog.style.width=((cur+1)/total*100)+'%';document.querySelectorAll('.ndot').forEach((d,j)=>d.classList.toggle('active',j===cur));}
let cur=0;
function goTo(idx){if(idx===cur)return;const prev=cur;slides[prev].classList.add('exit');setTimeout(()=>slides[prev].classList.remove('active','exit'),350);cur=idx;slides[cur].classList.add('active');upd();}
function next(){if(cur<total-1)goTo(cur+1);}
function prev(){if(cur>0)goTo(cur-1);}
document.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();next();}if(e.key==='ArrowLeft'){e.preventDefault();prev();}});
let tx=0;
document.addEventListener('touchstart',e=>tx=e.touches[0].clientX);
document.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-tx;if(dx<-50)next();if(dx>50)prev();});
upd();
</script>

</body>
</html>
