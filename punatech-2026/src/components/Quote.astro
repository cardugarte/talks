---
interface Props {
  author?: string;
  class?: string;
}
const { author, class: className = '' } = Astro.props;
---
<blockquote class:list={["bg-purple/5 border-l-[3px] border-purple px-7 py-5 text-left", className]}>
  <p class="font-body text-base italic text-text leading-relaxed mb-2.5">
    <slot />
  </p>
  {author && (
    <cite class="font-mono text-[0.65rem] text-purple tracking-widest uppercase not-italic">
      — {author}
    </cite>
  )}
</blockquote>
