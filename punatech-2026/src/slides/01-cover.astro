---
---
<div class="slide slide-cover">
  <div class="cover-badge">
    <span class="mono">PunaTech · Salta · Mayo 2026</span>
  </div>

  <div class="cover-main">
    <div class="lbl" style="margin-bottom:20px;">Charla</div>
    <h1 class="cover-title">
      <span class="g">De chatbot</span><br>
      a colega
    </h1>
    <p class="cover-tagline">Agentes de IA que trabajan con vos</p>
  </div>

  <div class="cover-speaker">
    <div class="speaker-line">
      <span class="speaker-prompt">$ whoami</span>
      <span class="speaker-arrow"> → </span>
      <span class="speaker-name">La Zuricata</span>
    </div>
    <div class="speaker-meta">Cibersecurity &amp; Criptografía · <span style="color:var(--green)">zuricata.dev</span></div>
  </div>

  <div class="cover-cursor-block">
    <span class="t-prompt">➜ </span>
    <span id="typed-cmd" class="t-cmd"></span>
    <span class="cursor" id="cursor-1"></span>
    <div id="out-1" class="t-out" style="opacity:0">→ Inicializando agente...</div>
    <div id="out-2" class="t-out hi" style="opacity:0">✓ Listo para trabajar con vos</div>
  </div>
</div>

<style>
.cover-badge {
  position: absolute;
  top: 28px; left: 48px;
  font-family: var(--font-m);
  font-size: 0.62rem;
  color: var(--muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  border: 1px solid rgba(0,232,122,0.15);
  padding: 6px 12px;
  border-radius: 4px;
}
.cover-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 36px;
}
.cover-title {
  font-family: var(--font-d);
  font-size: clamp(3rem, 7vw, 6.5rem);
  font-weight: 900;
  line-height: 0.92;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: var(--text);
  margin-bottom: 20px;
}
.cover-title .g { color: var(--green); }
.cover-tagline {
  font-family: var(--font-b);
  font-size: clamp(1rem, 1.8vw, 1.4rem);
  color: #8ab89e;
  line-height: 1.5;
  max-width: 480px;
}
.cover-speaker {
  margin-bottom: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.speaker-line {
  font-family: var(--font-m);
  font-size: clamp(0.9rem, 1.3vw, 1.05rem);
}
.speaker-prompt { color: var(--green); }
.speaker-arrow  { color: var(--muted); }
.speaker-name   { color: var(--text); font-weight: 700; }
.speaker-meta {
  font-family: var(--font-m);
  font-size: 0.65rem;
  color: var(--muted);
  letter-spacing: 0.1em;
}
.cover-cursor-block {
  font-family: var(--font-m);
  font-size: 0.88rem;
  line-height: 1.9;
  text-align: center;
}
</style>

<script>
  const cmd = 'ai-agent run --objetivo "ser tu colega digital"';
  const slide = document.querySelector('.slide');

  function startTyping() {
    const te = document.getElementById('typed-cmd');
    const ce = document.getElementById('cursor-1');
    if (!te || !ce) return;
    let i = 0;
    function type() {
      if (i < cmd.length) { te.textContent += cmd[i++]; setTimeout(type, 32 + Math.random() * 28); }
      else {
        ce.style.display = 'none';
        setTimeout(() => {
          const o1 = document.getElementById('out-1');
          if (o1) { o1.style.opacity = '1'; o1.style.transition = 'opacity 0.5s'; }
          setTimeout(() => {
            const o2 = document.getElementById('out-2');
            if (o2) { o2.style.opacity = '1'; o2.style.transition = 'opacity 0.5s'; }
          }, 800);
        }, 400);
      }
    }
    setTimeout(type, 800);
  }

  if (slide?.classList.contains('active')) {
    startTyping();
  } else {
    const obs = new MutationObserver(() => {
      if (slide?.classList.contains('active')) { obs.disconnect(); startTyping(); }
    });
    if (slide) obs.observe(slide, { attributes: true, attributeFilter: ['class'] });
  }
</script>
